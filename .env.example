# ---------------------------------------------------------------------------
# desktop-comfyui-server configuration. Copy to .env and edit; Bun loads it on
# start.
# Every value below is optional — the defaults run a local, standalone server.
#
# The ComfyUI directory and the upstream servers can also be set from the
# management UI, which stores them in .state.json. Anything set there wins over
# the values here, so these are only the starting point for a fresh install.
# ---------------------------------------------------------------------------

# ComfyUI on this machine.
COMFY_URL=http://localhost:8188

# Where ComfyUI is checked out, so the UI can start and stop it. Leave it unset
# and fill it in on the Settings page instead.
# COMFY_DIR=

# What to run inside that directory. Unset means: use the virtualenv beside
# main.py if there is one, otherwise `python3 main.py`.
# COMFY_COMMAND=

# --- Management UI ---------------------------------------------------------
UI_ENABLED=true
UI_PORT=3939
# 127.0.0.1 keeps the UI on this machine. Use 0.0.0.0 to reach it from the LAN.
UI_HOSTNAME=127.0.0.1

# Shared secret for the UI. Empty means no check, which is fine on 127.0.0.1
# and is not fine on a network — the UI can start a process on this machine.
# Set one (`openssl rand -hex 24`) whenever UI_HOSTNAME is not loopback, then
# open the page once as http://host:3939/?token=<the value>. The browser
# remembers it; the address bar is tidied up straight away.
#
# Cross-site requests and requests for a hostname that is not an IP literal or
# `localhost` are always refused, token or not. That is what keeps a web page
# you happen to visit, or a domain pointed at 127.0.0.1, from driving this UI.
# UI_TOKEN=

# Where everything this server writes goes: workflows/, .state.json, .jobs.json.
# Defaults to this directory, which is what you want when running from source.
# The desktop app sets it, because a single-file build has nowhere of its own.
# DATA_DIR=

# --- Workflows -------------------------------------------------------------
# Where API-format workflow JSON lives. Defaults to DATA_DIR/workflows.
# WORKFLOW_DIR=

# Workflow used at startup, by file name without .json. When unset, the choice
# saved from the UI wins, and failing that the first file in the directory.
# WORKFLOW=

# How long one run may take before it is abandoned (ms).
JOB_TIMEOUT_MS=600000

# --- Upstream job servers (optional) ---------------------------------------
# Leave these unset to run standalone: the UI still works and runs workflows
# locally. Fill them in to also claim queued jobs from a job server. Number the
# blocks from 1 with no gaps; several upstreams (staging and production, say)
# can be served at once, and they are asked for work in this order. NAME is a
# log label and defaults to the URL host.
#
# These seed the Servers list on the Settings page. Once you save that list the
# stored one takes over and these are ignored.
# SERVER_1_URL=
# SERVER_1_HOST_ID=
# SERVER_1_HOST_SECRET=
# SERVER_1_NAME=

# SERVER_2_URL=
# SERVER_2_HOST_ID=
# SERVER_2_HOST_SECRET=
# SERVER_2_NAME=

# How often to ask upstreams for the next job (ms).
POLL_INTERVAL_MS=5000

# How often to report status to upstreams (ms).
HEARTBEAT_INTERVAL_MS=30000

# --- Auto-update (optional) ------------------------------------------------
# Between jobs, check git for a newer commit and, if there is one, exit with
# code 42 so a launcher script can pull and relaunch. A running job is never
# interrupted. Off by default.
AUTO_UPDATE=false
UPDATE_CHECK_INTERVAL_MS=60000
